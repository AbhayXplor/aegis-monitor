{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/triage-output.v2.json",
  "title": "TriageOutput (brief §3)",
  "description": "Strict schema. additionalProperties is false: the engine may not add fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "priority_level",
    "triage_category",
    "physiological_status",
    "hazard_assessment",
    "deconflicted_route_plan",
    "dispatcher_checklist",
    "user_satellite_reply"
  ],
  "properties": {
    "incident_id": { "type": "string", "pattern": "^INC-[0-9]{4,}$" },
    "priority_level": { "type": "integer", "minimum": 1, "maximum": 5 },
    "triage_category": {
      "enum": ["MEDEVAC", "COMBAT_EXTRACTION", "HOSTAGE_COVERT", "SAR", "SUPPLY_DROP"]
    },
    "physiological_status": { "type": "string", "minLength": 1, "maxLength": 400 },
    "hazard_assessment": { "type": "string", "minLength": 1, "maxLength": 600 },
    "deconflicted_route_plan": { "type": "string", "minLength": 1, "maxLength": 600 },
    "dispatcher_checklist": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "user_satellite_reply": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[\\x20-\\x7E]*$",
      "description": "'HAPTIC_ACK_ONLY' for covert/duress incidents, otherwise imperative ASCII <= 160 chars"
    }
  }
}
