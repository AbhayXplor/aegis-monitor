# Copy to .env (gitignored). Values already in the environment win over this file.
# Never commit real keys. Nothing here is required: with no .env the service runs fully
# deterministic and offline on a synthetic demo scenario.

# --- listener ---
# PORT=3001
# HOST=127.0.0.1                  # loopback by default; set 0.0.0.0 only behind a proxy with auth
# AEGIS_DB=./data/aegis.db        # SQLite incident database; ":memory:" for throwaway runs
# AEGIS_DEV=1                     # 0 disables /api/v1/dev/* simulators (do this in any real deployment)

# --- security ---
# AEGIS_MASTER_KEY=               # 64 hex chars (openssl rand -hex 32). Unset = ephemeral keys, rotated every restart
# AEGIS_KEY_EPOCH_S=86400         # per-device key rotation period
# AEGIS_MAX_AGE_S=86400           # how old a (mesh-delayed) beacon may be
# AEGIS_OPEN_PROVISIONING=1       # 0 = refuse devices not registered via PUT /api/v1/devices/{id}
# AEGIS_DISPATCH_TOKEN=           # when set, dispatcher API + WebSocket need "Authorization: Bearer <token>"
# AEGIS_CORS_ORIGINS=http://127.0.0.1:5173   # comma list; defaults to local dev origins, never "*"

# --- geo context (brief §2.B) ---
# AEGIS_GEO=demo                  # demo (synthetic scenario) | live
# AEGIS_WM_KEY=                   # WorldMonitor MCP key (X-WorldMonitor-Key) for conflict + natural-hazard layers
# AEGIS_WM_MCP_URL=https://worldmonitor.app/mcp   # or your own WorldMonitor deployment's /mcp
# AEGIS_UNITS_FILE=./units.json   # [{id,name,kind:GROUND|HELI|DRONE,lat,lon,available}] rescue assets (CAD-owned)

# --- model pass (brief §2.C), optional ---
# AEGIS_LLM=1
# AEGIS_LLM_PROVIDER=ollama       # ollama (default, Ollama Cloud) | openai (any OpenAI-compatible endpoint)
# AEGIS_LLM_URL=https://ollama.com/api/chat       # local: http://localhost:11434/api/chat
# AEGIS_LLM_MODEL=gemma4
# AEGIS_LLM_FALLBACK=             # comma list tried in order
# AEGIS_LLM_KEY=                  # or OLLAMA_API_KEY; server-side only, never sent to a browser
# AEGIS_LLM_TIMEOUT_MS=12000
